# Salin ke Vercel Project Settings -> Environment Variables. Jangan commit .env asli.

# Base URL project Supabase (TANPA akhiran /rest/v1/)
# WAJIB berasal dari project yang sama dengan key di bawah.
SUPABASE_URL=https://xiedmhatvuayvqqkfarh.supabase.co

# Service role key (rahasia) -- ambil dari Supabase Dashboard > Project Settings > API.
# Kode /api/contact menerima salah satu nama berikut (pakai SATU saja):
#   SUPABASE_SERVICE_ROLE_KEY  (setup manual)
#   SUPABASE_ROLE_KEY          (disediakan integrasi Vercel-Supabase)
#   SUPABASE_SECRET_KEY        (disediakan integrasi Vercel-Supabase)
SUPABASE_SERVICE_ROLE_KEY=

# Opsional: kunci origin yang boleh mengirim form kontak
ALLOWED_ORIGIN=https://rizuzaman-aceh-github-io.vercel.app

# Opsional: aktifkan live threat intel (ThreatFox), tanpa ini fallback ke DEMO TELEMETRY
THREATFOX_AUTH_KEY=
